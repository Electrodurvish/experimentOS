DJANGO_SETTINGS_MODULE=config.settings.local
SECRET_KEY=change-me-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

DATABASE_URL=postgres://experimentos:experimentos@db:5432/experimentos
REDIS_URL=redis://redis:6379/0

CASSANDRA_CONTACT_POINTS=cassandra
CASSANDRA_PORT=9042
CASSANDRA_KEYSPACE=experimentos
CASSANDRA_STICKY_ENABLED=True

KAFKA_BOOTSTRAP_SERVERS=kafka:29092
KAFKA_ENABLED=True

CLICKHOUSE_HOST=clickhouse
CLICKHOUSE_PORT=8123
CLICKHOUSE_DATABASE=experimentos

OTEL_ENABLED=True
OTEL_SERVICE_NAME=experimentos-api
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317

SENTRY_DSN=
SENTRY_ENVIRONMENT=development

CELERY_BROKER_URL=amqp://guest:guest@rabbitmq:5672//
DECISION_INTERVAL_SECONDS=300
HEALTH_INTERVAL_SECONDS=900
ALERT_WEBHOOK_URL=

ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5
AI_EFFORT=medium
